# Copy to desktop/self-hosted.env and replace these with your own endpoints.
# desktop/run-self-hosted.sh refuses Omi-managed backend URLs before launching.

# Run backend/ locally with uvicorn. No Docker is required for the default local path.
OMI_PYTHON_API_URL=http://localhost:8000

# run-self-hosted.sh starts desktop/Backend-Rust locally by default.
OMI_DESKTOP_API_URL=http://localhost:10201

# Optional. Defaults to ${OMI_DESKTOP_API_URL}/v2 when omitted.
# OMI_API_BASE_URL=http://localhost:10201/v2
